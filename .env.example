# Database configuration
DATABASE_PROVIDER=your_database_provider

# MongoDB configuration
MONGO_URL=your_mongodb_connection_url
MONGO_DB_NAME=your_database_name
MONGO_COLLECTION_NAME=your_todo_collection
MONGO_USER_COLLECTION_NAME=your_user_collection

# Firebase configuration
FIREBASE_CREDENTIALS_PATH=your_firebase_credentials_file_path
FIREBASE_TODO_COLLECTION=your_todo_collection
FIREBASE_USER_COLLECTION=your_user_collection

# PostgreSQL configuration
POSTGRES_URL=your_postgresql_connection_url

# Database switching configuration
DATABASE_SWITCH_PIPE_AUTHKEY=your_secure_random_key
DATABASE_SWITCH_PIPE_NAME=your_named_pipe_address

# JWT configuration
JWT_SECRET_KEY=your_jwt_secret_key
JWT_ALGORITHM=your_jwt_algorithm
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=your_token_expiry_minutes

# Frontend configuration
FRONTEND_URL=your_frontend_url