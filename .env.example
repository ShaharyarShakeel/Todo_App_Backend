# Database configuration
DATABASE_PROVIDER=your_database_provider

# MongoDB configuration
MONGO_URL=your_mongodb_connection_url
MONGO_DB_NAME=your_database_name
MONGO_COLLECTION_NAME=your_todo_collection
MONGO_USER_COLLECTION_NAME=your_user_collection

# Firebase configuration
FIREBASE_CREDENTIALS_PATH=your_firebase_credentials_file_path
FIREBASE_TODO_COLLECTION=your_todo_collection
FIREBASE_USER_COLLECTION=your_user_collection

# PostgreSQL configuration
POSTGRES_URL=your_postgresql_connection_url

# Database switching configuration
DATABASE_SWITCH_PIPE_AUTHKEY=your_secure_random_key
DATABASE_SWITCH_PIPE_NAME=your_named_pipe_address

# JWT configuration
JWT_SECRET_KEY=your_jwt_secret_key
JWT_ALGORITHM=your_jwt_algorithm
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=your_token_expiry_minutes

# Google Identity Services (public Web OAuth client ID)
GOOGLE_CLIENT_ID=your_google_web_client_id

# GitHub OAuth App (keep client secret in backend .env only)
GITHUB_CLIENT_ID=your_github_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback

# Resend transactional email
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL="Todo App <onboarding@resend.dev>"
RESEND_ALLOWED_RECIPIENT=your_resend_account_email

# Gmail SMTP fallback (use a Google App Password, not your normal password)
GMAIL_ADDRESS=your_gmail_address
GMAIL_APP_PASSWORD=your_google_app_password
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Protects POST /api/cron/send-todo-reminders; use a long random value.
CRON_SECRET=generate_a_long_random_secret

# Frontend configuration
FRONTEND_URL=your_frontend_url
