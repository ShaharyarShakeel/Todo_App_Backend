# Initial default used when the FastAPI process starts. Runtime switches do not edit this file.
DATABASE_PROVIDER=mongodb

# MongoDB is also used for account_registry, regardless of the registration default.
MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DB_NAME=todo_db
MONGO_COLLECTION_NAME=todos
MONGO_USER_COLLECTION_NAME=users

# Firebase Admin credentials and collections
FIREBASE_CREDENTIALS_PATH=D:\path\outside\repo\firebase-adminsdk.json
FIREBASE_TODO_COLLECTION=todos
FIREBASE_USER_COLLECTION=users

# PostgreSQL (Supabase or another PostgreSQL server)
POSTGRES_URL=postgresql://user:password@host:5432/database?sslmode=require

# Shared local IPC authentication key. Generate a unique random value for your machine.
DATABASE_SWITCH_PIPE_AUTHKEY=replace-with-a-long-random-local-key
DATABASE_SWITCH_PIPE_NAME=\\.\pipe\TodoApiDatabaseSwitch

# JWT and frontend configuration
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
FRONTEND_URL=http://localhost:5173
